{
  "name": "@zendiq/mcp",
  "version": "1.0.1",
  "mcpName": "ai.zendiq/mcp",
  "description": "MCP server for ZendIQ: screen Solana tokens for free, triage a swap ($0.01) or build it ($0.02), paid per call over x402. Zero custody.",
  "license": "MIT",
  "homepage": "https://zendiq.ai/agents/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZendIQ/ZendIQ-Agent-API.git"
  },
  "bugs": {
    "url": "https://github.com/ZendIQ/ZendIQ-Agent-API/issues"
  },
  "keywords": ["mcp", "model-context-protocol", "solana", "x402", "mev", "jupiter", "token-risk", "ai-agents"],
  "bin": {
    "zendiq-mcp": "src/mcp-server.js"
  },
  "files": [
    "src/mcp-server.js",
    "examples/keys.js",
    "examples/budget.js",
    "examples/zendiq-client.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "analyse": "node examples/analyse.js",
    "budget:init": "node examples/budget.js init 1.00",
    "demo": "node demo/server.js",
    "demo:check": "node demo/runner.js --check",
    "demo:run": "node demo/runner.js",
    "feed": "node examples/feed.js",
    "mcp": "node src/mcp-server.js",
    "optimize": "node examples/optimize.js",
    "test": "node --test examples/*.test.js",
    "watch": "node examples/watch.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@solana/kit": "5.5.1",
    "@x402/core": "2.22.0",
    "@x402/svm": "2.22.0"
  }
}
