# Reference only: nothing loads this file. Set these in your shell.
# Both URLs default to ZendIQ's live hosted API when unset.

# MCP server (src/mcp-server.js)
ZENDIQ_AGENT_URL=https://api.zendiq.ai
ZENDIQ_AGENT_NETWORK=mainnet
# Required on mainnet. The paying key is runtime/payer-mainnet.key.json (or AGENT_SECRET_SEED);
# ZENDIQ_AGENT_KEYPAIR is devnet-only and refused on mainnet.
ZENDIQ_AGENT_BUDGET_FILE=C:\path\to\ZendIQ-Agent-API\runtime\budget-mainnet.json

# Examples and demo runner (examples/*.js, demo/runner.js)
# Optional: the network is read from GET /v1/agent. If set, it must match or the run refuses.
AGENT_NETWORK=mainnet
ZENDIQ_API_URL=https://api.zendiq.ai
AGENT_RPC_URL=https://api.mainnet-beta.solana.com
AGENT_STATE_DIR=./runtime
# Mainnet RPC used to submit jupiter_swap transactions with --execute
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
