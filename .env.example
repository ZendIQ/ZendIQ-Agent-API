# Devnet-first example. Replace these with infrastructure you control.
ZENDIQ_AGENT_URL=http://127.0.0.1:3111
ZENDIQ_AGENT_NETWORK=devnet
ZENDIQ_AGENT_KEYPAIR=C:\path\to\devnet-keypair.json

AGENT_NETWORK=devnet
ZENDIQ_API_URL=http://127.0.0.1:3111
AGENT_RPC_URL=https://api.devnet.solana.com
AGENT_BUDGET_FILE=./budget-devnet.json
